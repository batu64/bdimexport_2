# Bdimexport env referansı — yalnız ANAHTAR ADLARI + public config. GERÇEK gizli/kişisel değerler:
#   Next (yerel)      → .env.local            (gitignore'lu)
#   workers/api yerel → workers/api/.dev.vars (gitignore'lu; `wrangler dev` okur)
#   prod/staging      → Cloudflare Pages env / `wrangler secret put <AD> [--env staging]`

# --- Next.js (public, build'e gömülür) ---
NEXT_PUBLIC_API_BASE=            # örn. https://api.bdimexport.com (FAZ_1 1.6 başvuru formu)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=  # Turnstile site key (public)

# --- workers/api secret'ları ---
TURNSTILE_SECRET=                # secret → wrangler secret put TURNSTILE_SECRET

# --- Cloudflare Access / admin guard (FAZ_3 3.1 — app/admin/middleware.ts) ---
# Public config → workers/api/wrangler.toml [vars] içinde gerçek değerleriyle duruyor:
ACCESS_TEAM_DOMAIN=bdimexport.cloudflareaccess.com
ACCESS_AUD=a75b6ebb930d4c5b56b63e811bb7ca719ae2a78b916d7239477290ffda542fea
# Kişisel veri → repoya YAZILMAZ; prod: wrangler secret put ADMIN_EMAILS · yerel: workers/api/.dev.vars
ADMIN_EMAILS=                    # virgülle, boşluksuz: ad@ornek.com,ad2@ornek.com
VIEWER_EMAILS=                   # boş olabilir (yalnız Dashboard görür)

# --- ops: scripts/setup-access.mjs (Cloudflare API) — ASLA commit'leme ---
CLOUDFLARE_API_TOKEN=            # izin: Account › Access: Apps and Policies › Edit (+ Access: Organizations… Read)
CLOUDFLARE_ACCOUNT_ID=

# Harici AI: yalnız Gemini, ayarı EN SONDA (AGENTS.md §9) — şimdilik anahtar gerekmez.
